<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Images\icon.ico</ApplicationIcon>
	  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.2</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
    <InformationalVersion>1.2.2b5</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Fonts\Vazirmatn-Black.ttf" />
    <None Remove="Assets\Fonts\Vazirmatn-Bold.ttf" />
    <None Remove="Assets\Fonts\Vazirmatn-ExtraBold.ttf" />
    <None Remove="Assets\Fonts\Vazirmatn-ExtraLight.ttf" />
    <None Remove="Assets\Fonts\Vazirmatn-Light.ttf" />
    <None Remove="Assets\Fonts\Vazirmatn-Medium.ttf" />
    <None Remove="Assets\Fonts\Vazirmatn-Regular.ttf" />
    <None Remove="Assets\Fonts\Vazirmatn-SemiBold.ttf" />
    <None Remove="Assets\Fonts\Vazirmatn-Thin.ttf" />
    <None Remove="Assets\Images\Logo.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Images\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DocX" Version="5.2.0" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.9.0" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\Vazirmatn-Black.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Bold.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-ExtraBold.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-ExtraLight.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Light.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Medium.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Regular.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Thin.ttf" />
    <Resource Include="Assets\Images\Logo.jpg" />
  </ItemGroup>

</Project>
