<Window x:Class="Senik.DataTransformer.Views.Windows.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="اتصال به پایگاه داده" Height="600" Width="600"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FlowDirection="RightToLeft" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="GlassPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.4" BeginTime="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="GlassPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.4" BeginTime="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <materialDesign:DialogHost Identifier="ConnectionDialog" DialogTheme="Inherit" Background="Transparent">
        <Border x:Name="MainBackgroundBorder" CornerRadius="30" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="BgGradient1" Color="#E0EAFC" Offset="0.0" />
                    <GradientStop x:Name="BgGradient2" Color="#CFDEF3" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Border x:Name="GlassPanel" Margin="25" CornerRadius="24" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="GlassBorderBrush" Color="#80FFFFFF" />
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush x:Name="GlassBrush" Color="White" Opacity="0.85" />
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="5" Color="Black" Opacity="0.15" />
                </Border.Effect>

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- هدر -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="ServerNetwork" Width="44" Height="44" Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="اتصال به پایگاه داده سه نیک" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center"/>
                        <TextBlock Text="سرور SQL خود را انتخاب کنید تا لیست دیتابیس‌ها بارگذاری شود." FontSize="12.5" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- فیلدها -->
                    <StackPanel Grid.Row="1">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 🟢 تغییر ۵: IsEditable="False" برای جلوگیری از تایپ اشتباه -->
                            <ComboBox x:Name="CmbServers" Grid.Column="0" materialDesign:HintAssist.Hint="انتخاب سرور SQL (در حال جستجو...)" 
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}" IsEditable="False" Width="430" Height="50"
                                      Foreground="{DynamicResource MaterialDesignBody}" FontSize="15" VerticalAlignment="Center"/>
                            <Button x:Name="BtnRefreshServers" Grid.Column="1" Click="RefreshServers_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Width="50" Height="40" Margin="10,0,0,0" ToolTip="جستجوی مجدد سرورها" materialDesign:ButtonAssist.CornerRadius="10">
                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </Button>
                        </Grid>

                        <!-- 🟢 تغییر ۲: SelectedIndex="1" برای پیش‌فرض بودن نام کاربری و رمز عبور -->
                        <ComboBox x:Name="CmbAuthType" materialDesign:HintAssist.Hint="نوع احراز هویت" 
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                  Foreground="{DynamicResource MaterialDesignBody}" FontSize="15" Margin="0,0,0,18" SelectedIndex="1" SelectionChanged="CmbAuthType_SelectionChanged">
                            <ComboBoxItem Content="Windows Authentication (تاییدیه ویندوز)"/>
                            <ComboBoxItem Content="SQL Server Authentication (نام کاربری و رمز عبور)"/>
                        </ComboBox>

                        <!-- 🟢 تغییر ۴: تنظیم دقیق TabIndex -->
                        <TextBox x:Name="TxtUsername" TabIndex="1" materialDesign:HintAssist.Hint="نام کاربری (مثل sa)" 
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 Foreground="{DynamicResource MaterialDesignBody}" FontSize="15" Margin="0,0,0,18"/>

                        <PasswordBox x:Name="TxtPassword" TabIndex="2" materialDesign:HintAssist.Hint="رمز عبور (Password)" 
                                     Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}" 
                                     Foreground="{DynamicResource MaterialDesignBody}" FontSize="15" Margin="0,0,0,18"
                                     materialDesign:TextFieldAssist.HasClearButton="True"/>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="بارگذاری دیتابیس‌ها" TabIndex="3" Click="TestConnection_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="42" materialDesign:ButtonAssist.CornerRadius="12" Margin="0,0,12,0"/>

                            <ComboBox x:Name="CmbDatabases" TabIndex="4" Grid.Column="1" materialDesign:HintAssist.Hint="انتخاب دیتابیس سه نیک" 
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                      Foreground="{DynamicResource MaterialDesignBody}" FontSize="15" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- فوتر -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Button Content="خروج" Click="Exit_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#EF4444" materialDesign:ButtonAssist.CornerRadius="12" HorizontalAlignment="Left" Width="100" Height="42" FontSize="14" FontWeight="Bold"/>
                        <!-- 🟢 تغییر ۴: IsDefault="True" برای عملکرد اینتر -->
                        <Button Content="🚀 اتصال و ورود به سیستم" IsDefault="True" TabIndex="5" Click="Connect_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#10B981" Foreground="White" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" HorizontalAlignment="Right" Padding="25,0" Height="42" FontSize="15" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </materialDesign:DialogHost>
</Window>