<Window x:Class="Senik.DataTransformer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="سیستم واردات مالی سه نیک" 
        Height="768" Width="1100"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}">

    <WindowChrome.WindowChrome>
        <!-- بازگشت لبه‌های گرد و نرم (CornerRadius=30) -->
        <WindowChrome CaptionHeight="55" ResizeBorderThickness="0" CornerRadius="30" GlassFrameThickness="1"/>
    </WindowChrome.WindowChrome>

    <materialDesign:DialogHost Identifier="RootDialog" DialogTheme="Inherit" Background="Transparent">
        <!-- بازگشت CornerRadius=30 برای کادر اصلی -->
        <Border x:Name="MainBackgroundBorder" CornerRadius="30" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="BgGradient1" Color="#E0EAFC" Offset="0.0" />
                    <GradientStop x:Name="BgGradient2" Color="#CFDEF3" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Border x:Name="GlassPanel" Margin="20" CornerRadius="24" BorderThickness="1">
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="GlassBorderBrush" Color="#80FFFFFF" />
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush x:Name="GlassBrush" Color="White" Opacity="0.45" />
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="5" Color="Black" Opacity="0.1" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="75"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">

                        <!-- ZIndex=10 تا همیشه روی بقیه المان‌ها باشد -->
                        <StackPanel Panel.ZIndex="10" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/Images/Logo.jpg" Width="40" Height="40" Margin="0,0,15,0" Stretch="Uniform"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="سیستم تبدیل اطلاعات سه نیک" Foreground="{DynamicResource MaterialDesignBody}" FontSize="20" FontWeight="Bold" FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn Bold"/>
                                <TextBlock x:Name="StableText" Text="BETA7" Foreground="Red" FontSize="13" TextAlignment="Center" Margin="265,-35,0,0" FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn Light"/>

                                <TextBlock x:Name="VersionText" Text="نسخه ۱.۳.۰" Foreground="{DynamicResource MaterialDesignBody}" FontSize="13" TextAlignment="Center" Margin="252,-20,0,0" FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn Light"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- دکمه‌های کنترل پنجره -->
                        <StackPanel Panel.ZIndex="5" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0">
                            
                            <Button x:Name="BtnClose" Width="50" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Close_Click" Style="{StaticResource MaterialDesignFlatButton}" materialDesign:RippleAssist.Feedback="#FF5F56" materialDesign:ButtonAssist.CornerRadius="20">
                                <Ellipse Width="14" Height="14" Fill="#FF5F56" Stroke="#E0443E" StrokeThickness="1"/>
                            </Button>
                            <Button Width="50" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Maximize_Click" Style="{StaticResource MaterialDesignFlatButton}" materialDesign:RippleAssist.Feedback="#FFBD2E" materialDesign:ButtonAssist.CornerRadius="20">
                                <Ellipse Width="14" Height="14" Fill="#FFBD2E" Stroke="#DEA123" StrokeThickness="1"/>
                            </Button>
                            <Button x:Name="BtnMinimize" Width="50" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" materialDesign:RippleAssist.Feedback="#27C93F" materialDesign:ButtonAssist.CornerRadius="20">
                                <Ellipse Width="14" Height="14" Fill="#27C93F" Stroke="#1AAB29" StrokeThickness="1"/>
                            </Button>
<Button Click="BtnHelpTour_Click" ToolTip="راهنمای استفاده از سیستم"
        Style="{StaticResource MaterialDesignToolButton}" 
        Foreground="{DynamicResource MaterialDesignBody}" 
        Width="35" Height="35" Margin="0,0,5,0">
    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="22" Height="22"/>
</Button>
                        </StackPanel>

                        <StackPanel Panel.ZIndex="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                            <!-- نشانگر زنده دیتابیس با قابلیت مخفی شدن اتوماتیک -->
                            <Border Visibility="{Binding IsDatabaseConnected, Converter={StaticResource BoolToVis}}" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="16" Height="40" Padding="15,8" Margin="0,0,15,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,10,0">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.8" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ConnectedServerInfo}" FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn SemiBold" Foreground="#10B981" VerticalAlignment="Center" FontSize="11.5"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="ThemeToggleButton" Width="60" Height="50" Margin="0,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleTheme_Click" ToolTip="تغییر حالت شب/روز" materialDesign:ButtonAssist.CornerRadius="20">
                                <materialDesign:PackIcon x:Name="ThemeIcon" Kind="WeatherNight" Width="28" Height="28" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="10,0,10,10"/>
                </Grid>
            </Border>
        </Border>
    </materialDesign:DialogHost>
</Window>