<Window x:Class="Senik.DataTransformer.Views.Windows.SenikDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="پیام سیستم" Width="420"
        SizeToContent="Height" MinHeight="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="RightToLeft" FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="GlassBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="GlassBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.15"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="GlassBorder" Margin="20" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid>
            <!-- بک گراند دیالوگ (یکپارچه برای هدر و فوتر) -->
            <Border Background="{DynamicResource MaterialDesignPaper}" Opacity="0.98" CornerRadius="20"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="25,25,25,10" HorizontalAlignment="Center">
                    <materialDesign:PackIcon x:Name="IconAlert" Kind="InformationOutline" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtTitle" Text="پیام" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn Bold"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" MaxHeight="250" VerticalScrollBarVisibility="Auto" Margin="25,10,25,25">
                    <ContentControl x:Name="ContentBody" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                </ScrollViewer>

                <!-- فوتر با پس زمینه نامرئی (یکپارچه با کل دیالوگ) -->
                <StackPanel Grid.Row="2" x:Name="SpButtons" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,20"/>
            </Grid>
        </Grid>

        <Border.Effect>
            <!-- سایه بسیار نرم و حرفه ای -->
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="Black" Opacity="0.15"/>
        </Border.Effect>
    </Border>
</Window>