<UserControl x:Class="Senik.DataTransformer.Views.Components.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="520" Background="Transparent" FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn">

    <Border CornerRadius="24" BorderThickness="1" BorderBrush="#80FFFFFF" ClipToBounds="True">
        <Grid>
            <!-- پس‌زمینه نیمه‌شفاف شیشه‌ای -->
            <Border Background="{DynamicResource MaterialDesignPaper}" Opacity="0.95" CornerRadius="24"/>

            <StackPanel Margin="30">
                <!-- آیکون و هدر دینامیک -->
                <materialDesign:PackIcon Kind="{Binding DialogIcon, FallbackValue='DatabaseCheck'}" Width="52" Height="52" 
                                         Foreground="{Binding DialogIconColor, FallbackValue='#10B981'}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock Text="{Binding DialogTitle, FallbackValue='بررسی و تایید نهایی انتقال داده'}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource MaterialDesignBody}"/>
                <TextBlock Text="{Binding DialogSubTitle, FallbackValue='خلاصه وضعیت اعتبارسنجی پکیج واردات قبل از درج در SQL Server:'}" 
                           Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

                <!-- کارت خلاصه نتایج اعتبارسنجی -->
                <Border Background="{DynamicResource MaterialDesignTextFieldBoxBackground}" CornerRadius="16" Padding="18" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="📦 موجودیت فعال:" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="✅ رکوردهای سالم و آماده درج:" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding ValidRecordsCount, StringFormat={}{0:N0} ردیف, FallbackValue=''}" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="❌ خطاهای ساختاری / تکراری (مانع درج):" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding ErrorRecordsCount, StringFormat={}{0:N0} خطا, FallbackValue=''}" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="⚡ استراتژی تراکنش:" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#0284C7"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- پیام هشدار خطاها -->
                <Border Background="#11EF4444" BorderBrush="#4DEF4444" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,15"
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⚠️ به دلیل وجود خطای صحت داده، اجازه شروع عملیات تا رفع کامل خطاها مسدود می‌باشد." 
                               Foreground="#992626" FontSize="11.5" FontWeight="Bold" TextAlignment="Center"/>
                </Border>

                <!-- ردیف دکمه‌های اصلی -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="بازگشت و اصلاح" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            Foreground="#64748B" BorderBrush="#CBD5E1" materialDesign:ButtonAssist.CornerRadius="14" Height="44" FontSize="14" Cursor="Hand">
                        <Button.CommandParameter>
                            <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">False</system:Boolean>
                        </Button.CommandParameter>
                    </Button>

                    <Button Grid.Column="2" Content="🚀 شروع عملیات درج" Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            IsEnabled="{Binding CanExecuteImport}"
                            Background="#10B981" BorderThickness="0" Foreground="White" materialDesign:ButtonAssist.CornerRadius="14" Height="44" FontSize="14" FontWeight="Bold" Cursor="Hand">
                        <Button.CommandParameter>
                            <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">True</system:Boolean>
                        </Button.CommandParameter>
                    </Button>
                </Grid>

                <!-- دکمه نارنجی Glassmorphism دانلود گزارش خطا با عرض کامل -->
                <Border Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}"
                        Background="#11F59E0B" BorderBrush="#4DF59E0B" BorderThickness="1.5" CornerRadius="14" Margin="0,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Color="#F59E0B" Opacity="0.25" ShadowDepth="2"/>
                    </Border.Effect>
                    <Button Command="{Binding DownloadErrorReportCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                            Height="48" HorizontalAlignment="Stretch" materialDesign:ButtonAssist.CornerRadius="14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileDocumentAlertOutline" Foreground="#D97706" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="📥 دانلود گزارش جامع خطاها (فایل Word راهنما + Excel سلول‌ها)" Foreground="#D97706" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>